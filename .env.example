DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=1234567890123456789
TMDB_API_KEY=your_tmdb_api_key_here

# Games section source: "steam" (no key needed, PC only) or "rawg" (needs key,
# cross-platform). Leave unset to auto-pick: rawg if a key is set, else steam.
# GAME_SOURCE=steam

# Optional — only needed if you want RAWG (cross-platform) instead of Steam.
# Free key from https://rawg.io/apidocs. Without it, games come from Steam.
RAWG_API_KEY=your_rawg_api_key_here

PRIMARY_REGION=MY
FALLBACK_REGIONS=SG,US,JP,GB,ID,TH,PH

# Local timezone + twice-daily digests (09:00 and 20:00)
TIMEZONE=Asia/Kuala_Lumpur
DIGEST_HOURS=9,20
DIGEST_CRON=0 9,20 * * *

POST_WEEKLY_SUMMARY=true
WEEKLY_SUMMARY_CRON=0 21 * * 0

# Which sections to include (comma list): anime,movie,tv,cinema,game
CONTENT_TYPES=anime,movie,tv,cinema,game
# How far ahead to look for cinema / game releases (days)
CINEMA_WINDOW_DAYS=45
GAME_WINDOW_DAYS=30
