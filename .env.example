# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Channel ID for #releases (right-click channel → Copy Channel ID, needs Developer Mode)
DISCORD_CHANNEL_ID=1234567890123456789

# TMDB API key (free) from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Primary country for "is it on my plan here?"
# Malaysia = MY
PRIMARY_REGION=MY

# Extra regions to check when something is NOT on PRIMARY_REGION
# Common SEA / English catalogs: SG, US, JP, GB, ID, TH, PH
FALLBACK_REGIONS=SG,US,JP,GB,ID,TH,PH

# How many minutes before air time to notify (anime with exact schedule)
NOTIFY_MINUTES_BEFORE=30

# How often to poll APIs (cron). Default: every 10 minutes
POLL_CRON=*/10 * * * *

# Optional: only post anime / movies / tv (comma-separated). Leave empty for all.
# CONTENT_TYPES=anime,movie,tv
