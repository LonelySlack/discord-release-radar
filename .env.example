DISCORD_TOKEN=your_discord_bot_token_here
# One channel, or several separated by commas to post the digest to each.
DISCORD_CHANNEL_ID=1234567890123456789
TMDB_API_KEY=your_tmdb_api_key_here

# Games section source: "steam" (no key needed, PC only) or "rawg" (needs key,
# cross-platform). Leave unset to auto-pick: rawg if a key is set, else steam.
# GAME_SOURCE=steam

# Optional — only needed if you want RAWG (cross-platform) instead of Steam.
# Free key from https://rawg.io/apidocs. Without it, games come from Steam.
RAWG_API_KEY=your_rawg_api_key_here

PRIMARY_REGION=MY
FALLBACK_REGIONS=SG,US,JP,GB,ID,TH,PH

# Local timezone + twice-daily digests (09:00 and 20:00)
TIMEZONE=Asia/Kuala_Lumpur
DIGEST_HOURS=9,20
DIGEST_CRON=0 9,20 * * *

POST_WEEKLY_SUMMARY=true
WEEKLY_SUMMARY_CRON=0 21 * * 0

# Which sections to include (comma list).
# epic / gamepass / psplus need no API key — drop them here to turn them off.
CONTENT_TYPES=anime,movie,tv,cinema,game,epic,gamepass,psplus
# How far ahead to look for cinema / game releases (days)
CINEMA_WINDOW_DAYS=45
GAME_WINDOW_DAYS=30
# How far BACK "new on your services" reaches (days), and the popularity floor
# that keeps the newest-first list free of filler. Raise the floor for a
# stricter list, lower it for a longer one.
MOVIE_WINDOW_DAYS=90
MOVIE_MIN_POPULARITY=10

# How long a PlayStation Plus announcement stays on the board. Sony posts the
# line-up monthly, so anything under ~30 days leaves the section empty for weeks.
PSPLUS_WINDOW_DAYS=45

# Row caps for the Free & Subs tab.
MAX_FREE_GAMES=8
MAX_GAMEPASS=10
MAX_PSPLUS=3

# ── Showcase Radar ───────────────────────────────────────────────────────────
# Upcoming gaming + tech showcases (Nintendo Direct, State of Play, Xbox,
# Apple, Xiaomi, the AI keynotes). Posted as its OWN message, separate from the
# daily release board. The calendar lives in config/showcases.json.
SHOWCASES_ENABLED=true
# Post the showcase board somewhere else (e.g. #announcements). Unset = same
# channel(s) as the digest.
# SHOWCASE_CHANNEL_ID=1234567890123456789
# How far ahead the board looks.
SHOWCASE_WINDOW_DAYS=90
# Countdown alerts fire once at each of these marks before a CONFIRMED date.
SHOWCASE_LEAD_DAYS=7,5,1,0
# Daily board post — 09:30, just after the morning digest.
SHOWCASE_CRON=30 9 * * *
# How often to check whether an event crossed a lead mark.
SHOWCASE_ALERT_CRON=5 * * * *
# Watch PlayStation Blog / Xbox Wire / Apple Newsroom / Nintendo's channel for
# newly announced showcases. No keys needed.
SHOWCASE_FEEDS=true
MAX_SHOWCASES=18
# Storefront sales get their own budget on the board — November has a Black
# Friday sale on five stores at once, and a shared cap would push the Directs off.
MAX_SALES=10
# How far /sales looks ahead. A year, so "wait for the Summer Sale?" is
# answerable in September.
SALE_WINDOW_DAYS=365
